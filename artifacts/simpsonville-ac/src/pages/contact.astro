---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteHeader } from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
import { LeadForm } from '../components/LeadForm';
---

<BaseLayout
  title="Contact Simpsonville AC Repair | 864-754-7291"
  description="Contact Simpsonville AC Repair for HVAC, plumbing, and electrical service. Call 864-754-7291 or fill out our online form. Serving Simpsonville & Greenville SC."
  canonical="/contact/"
>
  <div class="page-root">
    <div class="topbar">
      <div class="tb-inner">
        <span>📍 Serving Simpsonville &amp; Greenville Areas</span>
        <span class="tb-div">|</span>
        <span>📞 <a href="tel:8647547291" style="color:#fff;font-weight:700">864-754-7291</a></span>
      </div>
    </div>

    <SiteHeader client:load />

    <div class="inner-hero">
      <div class="inner-hero-inner">
        <nav class="inner-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span> › </span>
          <span>Contact</span>
        </nav>
        <h1 class="inner-h1">Contact Simpsonville AC Repair</h1>
        <a href="tel:8647547291" class="inner-cta-phone">
          📞 <strong>864-754-7291</strong> — Call Anytime
        </a>
      </div>
    </div>

    <div class="inner-body">
      <div class="inner-content-grid">
        <main class="inner-main">
          <h2 class="inner-h2">Get in Touch</h2>
          <p style="color:#555;line-height:1.8;margin-bottom:28px">
            Whether you need to schedule a service call, get a free estimate, ask a question, or reach us about an emergency, we're here to help. Use any of the contact methods below or fill out the form and we'll respond quickly.
          </p>

          <div class="contact-details-grid">
            <div class="contact-detail-card">
              <div class="contact-detail-icon">📞</div>
              <h3>Phone</h3>
              <a href="tel:8647547291" class="contact-detail-val">864-754-7291</a>
              <div class="contact-detail-sub">Simpsonville Line</div>
              <a href="tel:8647547291" class="contact-detail-val">864-754-7291</a>
              <div class="contact-detail-sub">Greenville Line</div>
            </div>
            <div class="contact-detail-card">
              <div class="contact-detail-icon">📍</div>
              <h3>Service Area</h3>
              <div class="contact-detail-val" style="font-size:15px">Simpsonville, SC 29681</div>
              <div class="contact-detail-sub">Serving Simpsonville, Greenville,<br />Mauldin &amp; Fountain Inn</div>
            </div>
            <div class="contact-detail-card">
              <div class="contact-detail-icon">🕐</div>
              <h3>Service Hours</h3>
              <div class="contact-detail-val" style="font-size:15px">Mon–Fri: 7am – 7pm</div>
              <div class="contact-detail-sub">Sat–Sun: Emergency Service<br />24/7 Emergency Line Available</div>
            </div>
            <div class="contact-detail-card">
              <div class="contact-detail-icon">🌐</div>
              <h3>Online</h3>
              <div class="contact-detail-val" style="font-size:14px">simpsonvilleacrepair.com</div>
              <div class="contact-detail-sub">Fill out our form for a<br />response within 1 hour</div>
            </div>
          </div>

          <div style="margin-top:36px">
            <h2 class="inner-h2">Service Area Map</h2>
            <div class="map-embed-wrap">
              <iframe
                title="Simpsonville SC Service Area"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d52975.35!2d-82.2532!3d34.7376!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88580e0a7e4b2d83%3A0xa4e6b01f04ee2b24!2sSimpsonville%2C%20SC!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
                width="100%"
                height="340"
                style="border:0;border-radius:10px"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>

          <div class="inner-related-links" style="margin-top:28px">
            <h3>Quick Links</h3>
            <div class="inner-related-grid">
              <a href="/free-estimate/" class="inner-related-card"><span>📋</span> Free Estimate</a>
              <a href="/emergency-ac-repair/" class="inner-related-card"><span>🚨</span> Emergency Repair</a>
              <a href="/ac-repair/" class="inner-related-card"><span>❄️</span> AC Repair</a>
              <a href="/ac-maintenance/" class="inner-related-card"><span>🛠️</span> AC Maintenance</a>
            </div>
          </div>
        </main>

        <aside class="inner-sidebar">
          <LeadForm client:load title="Send Us a Message" subtitle="We'll call you back within 1 hour." dark />
          <div style="background:#fff5f5;border:2px solid #CC2229;border-radius:12px;padding:16px;margin-top:16px">
            <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:15px;color:#CC2229;margin-bottom:6px">🚨 Emergency Service</div>
            <p style="font-size:13px;color:#555;margin:0 0 12px;line-height:1.5">AC out right now? Call us directly for fastest response.</p>
            <a href="tel:8647547291" class="cta-primary" style="display:block;text-align:center">📞 864-754-7291</a>
          </div>
        </aside>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
