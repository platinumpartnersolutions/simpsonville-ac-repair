---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteHeader } from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Privacy Policy | Simpsonville AC Repair"
  description="Privacy Policy for Simpsonville AC Repair — a local HVAC referral service connecting Simpsonville, SC homeowners with licensed contractors."
  canonical="/privacy-policy/"
>
  <div class="page-root">
    <div class="topbar">
      <div class="tb-inner">
        <span>📍 Serving Simpsonville &amp; Greenville Areas</span>
        <span class="tb-div">|</span>
        <span>📞 <a href="tel:8647547291" style="color:#fff;font-weight:700">864-754-7291</a></span>
      </div>
    </div>

    <SiteHeader client:load />

    <div class="inner-hero">
      <div class="inner-hero-inner">
        <nav class="inner-hero-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span> › </span>
          <span>Privacy Policy</span>
        </nav>
        <h1 class="inner-h1">Privacy Policy</h1>
        <p style="color:rgba(255,255,255,.8);font-size:0.9rem;margin-top:6px">Last updated: January 1, 2025</p>
      </div>
    </div>

    <div class="inner-body">
      <div style="max-width:820px;margin:0 auto;padding:48px 24px 64px">
        <main id="main-content">

          <div style="background:#EEF4FF;border-left:4px solid #0D2D6E;border-radius:8px;padding:18px 22px;margin-bottom:36px">
            <p style="margin:0;color:#2c3e6b;line-height:1.75;font-size:0.95rem">
              <strong>Important:</strong> Simpsonville AC Repair is a lead generation and referral service — not a licensed HVAC contractor. We connect homeowners with pre-screened, licensed, and insured HVAC contractors in the Simpsonville, SC area. All actual HVAC work is performed by independent third-party contractors.
            </p>
          </div>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">1. Who We Are</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            Simpsonville AC Repair ("we," "us," or "our") operates the website simpsonvilleacrepair.com. We are a local lead generation and referral service. When you contact us, we connect you with one or more licensed HVAC contractors in our network who will contact you directly to schedule service.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">2. Information We Collect</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:12px">When you use our website or submit a service request, we may collect:</p>
          <ul style="color:#555;line-height:1.8;margin:0 0 24px;padding-left:24px">
            <li><strong>Contact information</strong> — name, phone number, email address</li>
            <li><strong>Service details</strong> — type of HVAC service needed, ZIP code</li>
            <li><strong>Device and usage data</strong> — IP address, browser type, pages visited, referring URL (collected automatically via analytics tools)</li>
            <li><strong>Call data</strong> — if you call our tracking number, call duration and time are logged by our call tracking provider (CallRail)</li>
          </ul>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">3. How We Use Your Information</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:12px">We use the information we collect to:</p>
          <ul style="color:#555;line-height:1.8;margin:0 0 24px;padding-left:24px">
            <li>Connect you with licensed HVAC contractors in our network who can fulfill your service request</li>
            <li>Call or text you to confirm your service request and provide contractor contact details</li>
            <li>Improve our website and understand how visitors use it</li>
            <li>Comply with legal obligations</li>
          </ul>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            <strong>We do not sell your personal information to third parties for marketing purposes.</strong> We share your information only with HVAC contractors in our network for the purpose of fulfilling your service request. We may receive compensation from those contractors for each qualified referral.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">4. Consent to Contact</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            By submitting a form or calling our number, you expressly consent to be contacted by Simpsonville AC Repair and by one or more licensed HVAC contractors in our network, using the contact information you provide. Contact may be made by phone, text message (SMS), or email. Message and data rates may apply for SMS. You may opt out of SMS communications at any time by replying STOP.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">5. Cookies and Tracking</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            Our website uses cookies and similar tracking technologies to analyze traffic and improve user experience. We use Google Analytics to understand how visitors interact with our site. Google Analytics collects information anonymously. You can opt out of Google Analytics by installing the <a href="https://tools.google.com/dlpage/gaoptout" style="color:#1A7AC4" target="_blank" rel="noopener">Google Analytics opt-out browser add-on</a>. We also use CallRail for phone call tracking, which may set cookies to associate web sessions with phone calls.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">6. Data Retention</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            We retain your personal information for as long as reasonably necessary to fulfill your service request and for legitimate business purposes, generally no longer than 3 years. Call recordings (if any) are retained per CallRail's retention policy.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">7. Your Rights</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:12px">You have the right to:</p>
          <ul style="color:#555;line-height:1.8;margin:0 0 24px;padding-left:24px">
            <li>Request access to the personal information we hold about you</li>
            <li>Request correction or deletion of your personal information</li>
            <li>Opt out of future contact from us by calling 864-754-7291 or emailing us</li>
          </ul>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">8. Third-Party Links</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of those sites and encourage you to review their privacy policies.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">9. Children's Privacy</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            Our website is not directed at children under 13. We do not knowingly collect personal information from children. If you believe we have inadvertently collected such information, please contact us immediately.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">10. Changes to This Policy</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            We may update this Privacy Policy from time to time. The date at the top of this page indicates when it was last revised. Continued use of our website after changes are posted constitutes your acceptance of the revised policy.
          </p>

          <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1.25rem;color:#0D2D6E;margin:0 0 12px">11. Contact Us</h2>
          <p style="color:#444;line-height:1.8;margin-bottom:24px">
            If you have questions about this Privacy Policy or how we handle your personal information, please contact us:
          </p>
          <div style="background:#f7f9fd;border:1.5px solid #d8e2f3;border-radius:10px;padding:20px;margin-bottom:32px">
            <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:1rem;color:#0D2D6E;margin-bottom:10px">Simpsonville AC Repair</div>
            <div style="color:#444;font-size:0.9rem;line-height:2">
              📞 <a href="tel:8647547291" style="color:#1A7AC4">864-754-7291</a><br />
              📍 Simpsonville, SC 29681<br />
              🌐 simpsonvilleacrepair.com
            </div>
          </div>

          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <a href="/" style="display:inline-flex;align-items:center;gap:6px;background:#0D2D6E;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;padding:10px 20px;border-radius:6px;text-decoration:none">← Back to Home</a>
            <a href="/terms-of-service/" style="display:inline-flex;align-items:center;gap:6px;border:2px solid #0D2D6E;color:#0D2D6E;font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;padding:10px 20px;border-radius:6px;text-decoration:none">Terms of Service →</a>
          </div>

        </main>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
